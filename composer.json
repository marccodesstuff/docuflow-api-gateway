{
    "name": "docuflow/api-gateway",
    "description": "DocuFlow API Gateway - Laravel 11 + Filament 3 + Reverb + Sanctum",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Marc Velasquez",
            "email": "velasquezmarcvictor@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/reverb": "^1.0",
        "filament/filament": "^3.2",
        "spiral/roadrunner": "^3.0",
        "nyholm/psr7": "^1.8",
        "grpc/grpc": "^1.65",
        "google/protobuf": "^4.25",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-webhook-client": "^3.8",
        "livewire/livewire": "^3.4",
        "awssdk/aws-sdk-php": "^3.280",
        "league/flysystem-aws-s3-v3": "^3.27"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ray": "^1.33"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan filament:install --panels=admin"
        ],
        "test": [
            "@php artisan test"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" \"php artisan reverb:start\" \"php artisan roadrunner:start\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}